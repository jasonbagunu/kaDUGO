// kaDUGO database schema (PostgreSQL via Prisma)
//
// Core traceability chain:
//   DonationEvent -> PreRegistration -> Donor -> Donation -> BloodUnit -> TestRecord
//
// Design notes
//  * IDs are human-readable strings (DNR-00001, DON-2026-00001, BLD-2026-000001 ...)
//    generated by the API with the Counter table, so the existing frontend routes
//    like /donors/DNR-00124 keep working.
//  * Values that can be calculated are NOT stored, so they can never go out of
//    sync: a donor's total donations / last donation, and an event's arrived /
//    donations / blood-unit counts are computed from the related rows.
//  * Public pre-registrants are NOT users. They live only in PreRegistration.
//  * Clinical records (donors, donations, units) use Restrict on delete so the
//    traceability trail cannot be wiped by accident.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MEDTECH
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Prisma enum names cannot contain "+" or "-", so the database stores the
// real label ("A+") via @map and the API translates for the frontend.
enum BloodType {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum BloodComponent {
  WHOLE_BLOOD          @map("Whole Blood")
  PACKED_RBC           @map("Packed RBC")
  FRESH_FROZEN_PLASMA  @map("Fresh Frozen Plasma")
  PLATELET_CONCENTRATE @map("Platelet Concentrate")
}

enum UnitStatus {
  PENDING_TESTING @map("Pending Testing")
  USABLE          @map("Usable")
  QUARANTINED     @map("Quarantined")
  NOT_USABLE      @map("Not Usable")
  EXPIRED         @map("Expired")
  ISSUED          @map("Issued") // given out / released to a hospital or the DOH
}

enum TestingStatus {
  PENDING          @map("Pending")
  PASSED           @map("Passed")
  REACTIVE         @map("Reactive")
  FOR_CONFIRMATION @map("For Confirmation")
  COMPLETED        @map("Completed")
}

enum Sex {
  MALE
  FEMALE
}

enum DonorStatus {
  ACTIVE
  DEFERRED
  INACTIVE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum DonationStatus {
  COMPLETED
  DEFERRED
  CANCELLED
}

enum Attendance {
  PRE_REGISTERED @map("Pre-registered")
  ARRIVED        @map("Arrived")
  DID_NOT_ARRIVE @map("Did Not Arrive")
}

enum DonationOutcome {
  NONE           @map("—")
  DONATED        @map("Donated")
  DID_NOT_DONATE @map("Did Not Donate")
  DEFERRED       @map("Deferred")
}

// ─────────────────────────── System users ───────────────────────────

model User {
  id           String     @id // USR-001
  name         String
  username     String     @unique
  email        String     @unique
  passwordHash String // bcrypt hash, never the plain password
  role         Role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Who created this account (Super Admin creates Admins, Admins create MedTechs)
  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  eventsCreated        DonationEvent[]
  preRegsVerified      PreRegistration[]
  donationsRecorded    Donation[]
  testRecordsPerformed TestRecord[]
  unitActivities       UnitActivity[]
  auditLogs            AuditLog[]

  @@index([role])
  @@map("users")
}

// ─────────────────────────── Events & pre-registration ───────────────────────────

model DonationEvent {
  id               String      @id // EVT-2026-001
  name             String
  date             DateTime    @db.Date
  startTime        String // "08:00"
  endTime          String // "17:00"
  location         String
  description      String      @default("")
  organizer        String      @default("")
  contact          String      @default("")
  // Optional ways for registered donors to reach the organizers
  facebookUrl    String @default("")
  messengerUrl   String @default("")
  contactEmail   String @default("")
  otherPlatforms String @default("")
  status           EventStatus @default(UPCOMING)
  registrationOpen Boolean     @default(true)

  // Unguessable token for the public registration link, so the link cannot
  // be found by counting up event IDs.
  publicToken String   @unique @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  preRegistrations PreRegistration[]
  donations        Donation[]

  @@index([date])
  @@index([status])
  @@map("donation_events")
}

// A member of the public who signed up through an event's registration link.
model PreRegistration {
  id      String        @id // PRE-00001
  eventId String
  event   DonationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // What the person entered on the public form
  name         String
  dob          DateTime?  @db.Date
  sex          Sex?
  contact      String
  email        String     @default("")
  address      String     @default("")
  // Structured Region > Province > City > Barangay (PSGC codes + names); `address` holds the same as text
  addressDetails Json?
  // lower-case "name|date of birth": stops the same person being registered twice for one event
  dedupeKey    String?
  bloodType    BloodType?
  registeredAt DateTime   @default(now())

  // Filled in by staff on the day of the event
  attendance   Attendance      @default(PRE_REGISTERED)
  outcome      DonationOutcome @default(NONE)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?           @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  // Linked once the person is registered as a donor / donates
  donorId  String?
  donor    Donor?    @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donation Donation?

  @@unique([eventId, dedupeKey])
  @@index([eventId])
  @@index([attendance])
  @@map("pre_registrations")
}

// ─────────────────────────── Donors & donations ───────────────────────────

model Donor {
  id           String      @id // DNR-00001
  name         String
  dob          DateTime    @db.Date
  sex          Sex
  bloodType    BloodType
  contact      String
  email        String      @default("")
  address      String      @default("")
  // Structured Region > Province > City > Barangay (PSGC codes + names); `address` holds the same as text
  addressDetails Json?
  // lower-case "name|date of birth": a database-level stop for duplicate donors
  dedupeKey    String?     @unique
  status       DonorStatus @default(ACTIVE)
  registeredAt DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  donations        Donation[]
  preRegistrations PreRegistration[]

  @@index([name])
  @@index([bloodType])
  @@map("donors")
}

model Donation {
  id       String           @id // DON-2026-00001
  donorId  String
  donor    Donor            @relation(fields: [donorId], references: [id], onDelete: Restrict)
  eventId  String?
  event    DonationEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  preRegId String?          @unique
  preReg   PreRegistration? @relation(fields: [preRegId], references: [id], onDelete: SetNull)

  date      DateTime       @db.Date
  bloodType BloodType
  status    DonationStatus @default(COMPLETED)
  personnel String         @default("") // staff who handled the collection (free text)
  notes     String         @default("")

  recordedById String? // the logged-in user who entered the record
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  bloodUnit BloodUnit?

  @@unique([donorId, eventId])
  @@index([donorId])
  @@index([eventId])
  @@index([date])
  @@map("donations")
}

// ─────────────────────────── Blood units, testing, traceability ───────────────────────────

model BloodUnit {
  id         String   @id // BLD-2026-000001
  donationId String   @unique // exactly one unit per donation
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Restrict)

  bloodType      BloodType
  component      BloodComponent @default(WHOLE_BLOOD)
  collectionDate DateTime       @db.Date
  expirationDate DateTime       @db.Date
  status         UnitStatus     @default(PENDING_TESTING)
  testingStatus  TestingStatus  @default(PENDING)

  storageLocation String @default("Pending")
  shelf           String @default("—")
  position        String @default("—")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testRecords TestRecord[]
  activities  UnitActivity[]

  @@index([status])
  @@index([bloodType, status]) // inventory counts by blood type
  @@index([expirationDate])
  @@map("blood_units")
}

// One screening/testing entry for a unit. A unit can have more than one
// (for example a confirmatory test after a reactive screening); the newest
// entry is the current result.
model TestRecord {
  id     Int       @id @default(autoincrement())
  unitId String
  unit   BloodUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  testingDate     DateTime      @db.Date
  screeningStatus TestingStatus
  result          String // e.g. "All Non-Reactive"
  usabilityStatus UnitStatus

  testedById String?
  testedBy   User?    @relation(fields: [testedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  results TestResult[]

  @@index([unitId])
  @@map("test_records")
}

// Individual test lines inside a TestRecord (HIV, Hepatitis B, ...)
model TestResult {
  id           Int        @id @default(autoincrement())
  testRecordId Int
  testRecord   TestRecord @relation(fields: [testRecordId], references: [id], onDelete: Cascade)
  name         String
  result       String
  passed       Boolean

  @@index([testRecordId])
  @@map("test_results")
}

// Append-only history of everything that happens to a unit: collected, tested,
// stored, moved, released, transferred, disposed. This is the traceability
// timeline.
model UnitActivity {
  id            Int       @id @default(autoincrement())
  unitId        String
  unit          BloodUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  action        String // "Collected", "Tested", "Stored", "Released", ...
  note          String    @default("")
  occurredAt    DateTime  @default(now())
  performedById String?
  performedBy   User?     @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([unitId, occurredAt])
  @@map("unit_activities")
}

// ─────────────────────────── System ───────────────────────────

// System-wide activity trail (Super Admin only). User name and role are copied
// into the row so the history stays readable even if the account is removed.
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  userRole  Role?
  action    String
  details   String   @default("")
  ipAddress String?

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// Running numbers used to build the readable IDs above. Incremented inside a
// transaction so two people saving at the same moment never get the same ID.
model Counter {
  name  String @id // "donor", "donation-2026", "bloodunit-2026", ...
  value Int    @default(0)

  @@map("counters")
}
