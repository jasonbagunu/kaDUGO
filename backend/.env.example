# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/kadugo?schema=public"

# Port the Express API listens on
PORT=4000

# Origin allowed to call this API in dev (the Vite frontend)
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign JWTs -- change this to a long random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"

# How long an access token stays valid
JWT_EXPIRES_IN="8h"
